      { "workspace": "sdkwork-mcp-app-sdk", "surface": "app-api", "credentialMode": "global-token-manager", "packageName": "@sdkwork/mcp-app-sdk", "status": "active" }
    ],
    "events": [],
    "configKeys": [
      "VITE_SDKWORK_APPSTORE_APPLICATION_PUBLIC_HTTP_URL",
      "VITE_SDKWORK_SKILLS_APPLICATION_PUBLIC_HTTP_URL",
      "VITE_SDKWORK_MCP_APPLICATION_PUBLIC_HTTP_URL",
      "VITE_SDKWORK_NEWS_PLATFORM_API_GATEWAY_HTTP_URL",
      "VITE_SDKWORK_NEWS_DEMO_MODE",
      "VITE_SDKWORK_NEWS_ENVIRONMENT"
