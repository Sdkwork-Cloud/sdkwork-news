      { "name": "authTokenManager", "export": ".", "provider": "@sdkwork/sdk-common" },
      { "name": "newsAiStorePort", "export": ".", "provider": "@sdkwork/news-ai-store-sdk-adapter" },
      { "name": "newsAiStoreService", "export": ".", "provider": "@sdkwork/news-ai-store-service" }
